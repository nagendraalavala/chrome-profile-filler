{
  "manifest_version": 3,
  "name": "Profile Filler",
  "version": "1.0.0",
  "description": "Auto-fill forms with grouped/nested profile data. Supports addresses, work experience, education, social links, and more.",
  "permissions": ["storage", "activeTab", "scripting", "downloads"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
